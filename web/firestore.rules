rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products: public read (storefront + app). Only authenticated admins
    // may create / update / delete from the dashboard.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: anyone may create an order (web/app checkout, guest allowed).
    // Reading & full updates are restricted to authenticated admins, but a guest
    // customer may attach a PromptPay payment slip to their own order — limited
    // to the slip fields and only moving payment into 'pending_review' (they can
    // never mark an order as 'paid' or change amounts/status themselves).
    match /orders/{orderId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow delete: if request.auth != null;
      allow update: if request.auth != null
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['slipDataUrl', 'paymentStatus', 'updatedAt'])
          && request.resource.data.paymentStatus == 'pending_review'
        );
    }

    // Config (discount campaign / flash sale): public read so the storefront
    // popup + checkout promo code work for everyone. Only authenticated admins
    // may edit the campaign from the dashboard.
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Coupons: public read so checkout can validate a code; only admins write.
    // A guest checkout may only bump usedCount by exactly 1 (never past the
    // configured usageLimit) alongside updatedAt.
    match /coupons/{code} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'updatedAt'])
          && request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1
          && (
            resource.data.get('usageLimit', 0) == 0
            || request.resource.data.usedCount <= resource.data.get('usageLimit', 0)
          )
        );
    }

    // Public order tracking (PII-free mirror): anyone may read. Guests may only
    // open the mirror for a brand-new order (status 'Order Placed', empty
    // courier/tracking, no repeated status history); everything else is admin.
    match /tracking/{orderCode} {
      allow read: if true;
      allow create: if request.auth != null
        || (
          request.resource.data.keys().hasOnly(['orderCode', 'status', 'statusHistory', 'courier', 'trackingNumber', 'itemsCount', 'updatedAt'])
          && request.resource.data.orderCode == orderCode
          && request.resource.data.status == 'Order Placed'
          && request.resource.data.courier == ''
          && request.resource.data.trackingNumber == ''
          && request.resource.data.statusHistory.size() <= 1
          && request.resource.data.itemsCount is int
          && request.resource.data.itemsCount >= 0
        );
      allow update, delete: if request.auth != null;
    }

    // Reviews: public read (client filters approved), guests may submit an
    // unapproved review with limited fields; approval/deletion is admin-only.
    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true || request.auth != null;
      allow create: if request.resource.data.approved == false
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text.size() <= 1000
        && request.resource.data.photos.size() <= 3
        && request.resource.data.keys().hasOnly(['productId', 'orderCode', 'name', 'rating', 'text', 'photos', 'approved', 'createdAt']);
      allow update, delete: if request.auth != null;
    }
  }
}
